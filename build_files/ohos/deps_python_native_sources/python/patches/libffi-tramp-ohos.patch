--- a/src/tramp.c
+++ b/src/tramp.c
@@ -51,6 +51,9 @@
 #include <pthread.h>
 #include <sys/mman.h>
 #include <tramp.h>
+#ifdef __OHOS__
+#include <dlfcn.h>
+#endif
 #ifdef __linux__
 #include <linux/limits.h>
 #include <linux/types.h>
@@ -225,10 +228,16 @@
     if (fgets (line, sizeof (line), fp) == 0)
       break;
 
-    nfields = sscanf (line, "%lx-%lx %9s %lx %9s %ld %s",
-      &start, &end, perm, &offset, dev, &inode, file);
-    if (nfields != 7)
+    /* Preserve spaces in the pathname of the signed trampoline image. */
+    int path_offset = 0;
+    nfields = sscanf (line, "%lx-%lx %9s %lx %9s %lu %n",
+      &start, &end, perm, &offset, dev, &inode, &path_offset);
+    if (nfields != 6 || path_offset == 0)
       continue;
+    line[strcspn (line, "\n")] = '\0';
+    if (line[path_offset] == '\0' || strlen (line + path_offset) >= sizeof (file))
+      continue;
+    strcpy (file, line + path_offset);
 
     if (addr >= start && addr < end) {
       tramp_globals.offset = offset + (addr - start);
@@ -242,6 +251,16 @@
     return 0;
 
   tramp_globals.fd = open (file, open_flags);
+#ifdef __OHOS__
+  /* Shared storage mappings name the inaccessible backing filesystem.
+     The loader retains the application-visible path used for dlopen. */
+  if (tramp_globals.fd == -1)
+    {
+      Dl_info info;
+      if (dladdr ((void *) addr, &info) && info.dli_fname)
+        tramp_globals.fd = open (info.dli_fname, open_flags);
+    }
+#endif
   if (tramp_globals.fd == -1)
     return 0;
 
