--- a/Lib/_ohos_support.py
+++ b/Lib/_ohos_support.py
@@ -0,0 +1,51 @@
+"""Configuration support for relocatable native OpenHarmony installations."""
+import os
+import shlex
+import sys
+
+
+def customize_config_vars(config):
+    # sysconfig's installation schemes already use sys.base_prefix, but its
+    # compiler metadata also contains absolute directories from configure.
+    replacements = (
+        (config.get("exec_prefix"), sys.base_exec_prefix),
+        (config.get("prefix"), sys.base_prefix),
+    )
+    path_keys = (
+        "BINDIR", "LIBDIR", "LIBPL", "LIBDEST", "BINLIBDEST", "DESTSHARED",
+        "INCLUDEDIR", "CONFINCLUDEDIR", "INCLUDEPY", "CONFINCLUDEPY",
+        "SCRIPTDIR", "LIBPC", "MANDIR", "datarootdir", "datadir",
+    )
+    for key in path_keys:
+        value = config.get(key)
+        if not isinstance(value, str):
+            continue
+        for old, new in replacements:
+            if old and old != os.sep and (value == old or value.startswith(old + os.sep)):
+                config[key] = new + value[len(old):]
+                break
+
+    # Only the packaged distribution sets this marker. Ordinary source builds
+    # retain their configured compiler and dependency search paths.
+    deps = config.get("OHOS_BUILD_DEPS")
+    if not deps:
+        return
+    for key in ("CPPFLAGS", "CFLAGS", "PY_CFLAGS", "LDFLAGS", "PY_LDFLAGS",
+                "CONFIGURE_CPPFLAGS", "CONFIGURE_CFLAGS", "CONFIGURE_LDFLAGS"):
+        value = config.get(key)
+        if isinstance(value, str):
+            words = shlex.split(value)
+            config[key] = shlex.join(
+                word for word in words
+                if not (word.startswith(("-I", "-L")) and deps in word)
+                and not ("-rpath" in word and "ORIGIN" in word)
+            )
+    compiler = os.path.join(sys.base_prefix, "bin", "ohos-clang")
+    cxx = os.path.join(sys.base_prefix, "bin", "ohos-clang++")
+    config["CC"] = "/usr/bin/sh " + shlex.quote(compiler)
+    config["CXX"] = "/usr/bin/sh " + shlex.quote(cxx)
+    config["LDSHARED"] = config["CC"] + " -shared"
+    config["LDCXXSHARED"] = config["CXX"] + " -shared"
+    config["BLDSHARED"] = config["LDSHARED"]
+    config["AR"] = "llvm-ar"
+    config["RANLIB"] = "llvm-ranlib"
