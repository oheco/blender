{
  "module": {
    "name": "entry", "type": "entry", "mainElement": "EntryAbility",
    "deviceTypes": ["2in1"], "deliveryWithInstall": true, "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [{
      "name": "EntryAbility", "srcEntry": "./ets/entryability/EntryAbility.ets",
      "description": "$string:app_name", "icon": "$media:blender_app_icon", "label": "$string:app_name",
      "startWindowIcon": "$media:app_icon_foreground", "startWindowBackground": "$color:start_window_background",
      "exported": true, "orientation": "landscape",
      "skills": [{ "entities": ["entity.system.home"], "actions": ["ohos.want.action.home"] }]
    }],
    "requestPermissions": [
      { "name": "ohos.permission.INTERNET" },
      {
        "name": "ohos.permission.READ_WRITE_DESKTOP_DIRECTORY",
        "reason": "$string:reason_desktop_directory",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      },
      {
        "name": "ohos.permission.READ_WRITE_DOCUMENTS_DIRECTORY",
        "reason": "$string:reason_documents_directory",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      },
      {
        "name": "ohos.permission.READ_WRITE_DOWNLOAD_DIRECTORY",
        "reason": "$string:reason_download_directory",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      }
    ]
  }
}
