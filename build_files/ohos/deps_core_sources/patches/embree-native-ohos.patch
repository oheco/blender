--- a/common/sys/sysinfo.cpp
+++ b/common/sys/sysinfo.cpp
@@ -656,6 +656,9 @@
 #include <sys/ioctl.h>
 #include <sys/time.h>
 #include <pthread.h>
+#if defined(__OHOS__)
+#include <sched.h>
+#endif
 
 #if defined(__EMSCRIPTEN__)
 #include <emscripten.h>
@@ -671,6 +674,16 @@
 #if defined(__MACOSX__) || defined(__ANDROID__)
     nThreads = sysconf(_SC_NPROCESSORS_ONLN); // does not work in Linux LXC container
     assert(nThreads);
+#elif defined(__OHOS__)
+    // The OHOS SDK exposes current-thread sched affinity, not the pthread NP API.
+    cpu_set_t set;
+    CPU_ZERO(&set);
+    if (sched_getaffinity(0, sizeof(set), &set) == 0)
+      nThreads = CPU_COUNT(&set);
+    if (nThreads < 1) {
+      const long online = sysconf(_SC_NPROCESSORS_ONLN);
+      nThreads = online > 0 ? static_cast<int>(online) : 1;
+    }
 #elif defined(__EMSCRIPTEN__)
     // WebAssembly supports pthreads, but not pthread_getaffinity_np. Get the number of logical
     // threads from the browser or Node.js using JavaScript.
